# No data is distributed, here or on Zenodo: the repository and the archive
# carry the code, and the archive is made from this repository so the two
# cannot diverge. data/ is where the pipeline writes its intermediates. See
# the README. Keeping it out also keeps 15 MB of CSV out of every clone.
data/

# Regenerated by RunOutputs.R. The folders ship empty, keeping only
# their .gitkeep, so that what a reader runs is what they then compare.
outputs/tables/*
outputs/figures/*
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep

# R and MATLAB working files
.Rhistory
.RData
.Rproj.user/
*.asv
